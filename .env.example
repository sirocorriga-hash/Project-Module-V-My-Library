# Used by docker compose. Create .env with: sh scripts/setup.sh  (Windows: scripts\setup.ps1)
# or copy this file to .env and fill it in by hand.
SECRET_KEY=change-me-to-a-long-random-string
# Database password; use letters and digits only (it is embedded in the connection URL).
POSTGRES_PASSWORD=change-me-too
APP_URL=http://localhost:8000
# Port of the database on this computer (for running Flask outside Docker).
# Change it if another PostgreSQL already uses 5432.
DB_PORT=5432
# Optional: real email for password reset and loan reminders
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=My Library <no-reply@example.com>
