# Copy to backend/.env for local development (without Docker).
DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Public address, used in the links of password-reset emails
APP_URL=http://localhost:5000
# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=0
# Email (optional). Without MAIL_SERVER, emails are printed in the server log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=My Library <no-reply@localhost>
# Rate-limit storage; use redis://... when running several workers or servers
RATELIMIT_STORAGE_URI=memory://
